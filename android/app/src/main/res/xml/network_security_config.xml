<?xml version="1.0" encoding="utf-8"?>
<!-- Release / default: HTTPS only. Debug builds override this file from
     src/debug/res/xml to allow cleartext to the emulator host and localhost. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
